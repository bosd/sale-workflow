<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record
        id="product_search_form_view_inherit_sale_product_supplierinfo_search"
        model="ir.ui.view"
    >
        <field
            name="name"
        >product.search.form.inherit.sale.product.supplierinfo.search</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_search_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <separator />
                <filter
                    string="Search in Vendor Info"
                    name="search_in_vendor_info"
                    domain="[]"
                    context="{'search_in_vendor_info': True}"
                />
            </xpath>
        </field>
    </record>
</odoo>

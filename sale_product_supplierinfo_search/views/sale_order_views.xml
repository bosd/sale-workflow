<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record
        id="view_order_form_inherit_sale_product_supplierinfo_search"
        model="ir.ui.view"
    >
        <field
            name="name"
        >sale.order.form.inherit.sale.product.supplierinfo.search</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']//field[@name='product_id']"
                position="attributes"
            >
                <attribute
                    name="context"
                >{'sale_product_supplierinfo_search': True}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
